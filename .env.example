# Reference only. The backend reads process environment variables directly.

WECHAT_DB_ROOT=./data/db_decrypt/all
WECHAT_DECRYPTION_REPORT=./data/db_decrypt/decryption_report.json
WECHAT_ANALYTICS_CACHE=./.cache/analytics.sqlite

# Optional: required for Weixin-native FTS search.
WECHAT_FTS_EXTENSION=./dist/weixin_fts_tokenizer.dll
# Replace the placeholder with the local Weixin 4.1.9.23 directory.
WEIXIN_DLL_PATH=<path-to-weixin-4.1.9.23>/Weixin.dll

WECHAT_TIMEZONE=Asia/Shanghai
WECHAT_EPISODE_GAP_SECONDS=1800
WECHAT_RESPONSE_MAX_SECONDS=86400

# Vite development proxy and browser API base.
VITE_API_PROXY=http://127.0.0.1:8765
VITE_API_BASE=/api
